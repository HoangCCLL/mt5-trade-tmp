# ---- host: docker compose (.env) ----
GATEWAY_BIND=127.0.0.1:80      # where compose publishes the gateway (dev over tailnet: 100.x.x.x:80)
GATEWAY_API_KEY=change-me
AGENT_TOKENS={"A1":"tokA1","A2":"tokA2"}
RESULT_TIMEOUT=35
UNSUB_GRACE=30

# ---- VPS: deploy/vps/agent.env (one file per VPS = per account) ----
# GATEWAY_URL=wss://gateway.example.com
# ACCOUNT_ID=A1
# AGENT_TOKEN=tokA1
# ORDER_TIMEOUT=30
# CMD_TTL=5
# MT5_PATH=C:\mt5\A1\terminal64.exe
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
