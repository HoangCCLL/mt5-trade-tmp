# ---- host: docker compose (.env) ----
DOMAIN=gateway.example.com     # Caddy auto-TLS via Let's Encrypt. Use ":80" for plain HTTP on LAN.
GATEWAY_API_KEY=change-me
AGENT_TOKENS={"A1":"tokA1","A2":"tokA2"}
RESULT_TIMEOUT=35
UNSUB_GRACE=30

